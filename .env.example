# Supabase Connect > Transaction pooler (port 6543). URL-encode password characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Secret/service_role key: server only, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
# Must match your confirmed Supabase Authentication user. No first-visitor bootstrap.
OWNER_EMAIL=owner@example.com
